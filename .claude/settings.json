{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/nearest-agents-md.sh" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(go build:*)",
      "Bash(go test:*)",
      "Bash(go vet:*)",
      "Bash(go fmt:*)",
      "Bash(golangci-lint run:*)"
    ],
    "ask": [
      "Edit(./go.mod)",
      "Edit(./go.sum)",
      "Edit(./.github/workflows/**)",
      "Edit(./.goreleaser.yml)"
    ],
    "deny": [
      "Edit(./internal/providers/azure_resource_tag_support.csv)"
    ]
  }
}
